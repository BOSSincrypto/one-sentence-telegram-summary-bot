# Copy to .env for local development. On Fly these go in `fly secrets set`.

# --- required ---------------------------------------------------------------
# From @BotFather.
BOT_TOKEN=123456789:AA...

# Your numeric Telegram id (send /id to the bot, or ask @userinfobot).
# Comma-separated if more than one person should have access.
OWNER_IDS=123456789

# --- required in production, omit locally ------------------------------------
# Public origin of the deployment. On Fly it is derived from FLY_APP_NAME
# automatically, so you normally do not set this by hand.
# Leaving it empty switches the bot to long polling, which is what you want
# for local development.
# BASE_URL=https://your-app.fly.dev

# --- optional ---------------------------------------------------------------
# Bootstraps the OpenRouter key on first run; afterwards it lives in the
# database and is edited from the bot's "ИИ" screen.
# OPENROUTER_API_KEY=sk-or-...

# Lets the bot create and reprogram its own wake-up alarm on cron-job.org
# whenever you change the digest time. Without it the bot prints the URL and
# schedule for you to enter manually.
# CRONJOB_API_KEY=

# Override the derived secrets if you ever need to rotate them independently
# of the bot token.
# WEBHOOK_SECRET=
# TICK_KEY=

# DB_PATH=/data/bot.db
# PORT=8080
# LOG_LEVEL=INFO
